# HASA client — environment template
# Copy to client/.env.local for local overrides. Only VITE_* values reach the
# browser bundle, so never put a secret here.

# Pinagmulan ng API, WALANG /api sa dulo.
# Blangko = /api sa parehong origin (gumagamit ng Vite proxy sa dev).
# Production halimbawa: https://hasa-api.onrender.com
VITE_API_URL=

# Pampublikong URL ng site para sa canonical at Open Graph.
# Blangko = kasalukuyang window.location.origin.
# Production halimbawa: https://hasa-xtg1.vercel.app
VITE_SITE_URL=
