{
  "name": "hasa-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HASA API \u2014 secure sessions, role-based access, Araling Panlipunan content, and progress tracking",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "check": "node --check src/index.js",
    "seed:reset": "node --env-file-if-exists=.env src/db/reset.js"
  },
  "dependencies": {
    "express": "5.1.0"
  }
}
