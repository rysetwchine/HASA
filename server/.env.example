# HASA API — environment template
# Copy to server/.env (never commit it) or set these in your host's dashboard.

NODE_ENV=development
PORT=3000

# 48+ random characters. Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# SQLite file. Use an absolute path on a host with a persistent volume.
DATABASE_PATH=./server/data/hasa.sqlite

# Browser origin allowed to send credentialed requests.
# Development default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Required to self-register teacher accounts. Leave blank to disable.
TEACHER_SIGNUP_CODE=

# Set to 1 behind a reverse proxy such as Render/Railway/Fly.
TRUST_PROXY=0

# --- Optional AI simplification (server-side only) --------------------------
# Leave keys blank to disable. The app reports AI_NOT_CONFIGURED rather than
# inventing an answer.
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_QUOTA_PER_STUDENT=20
AI_REQUEST_TIMEOUT_MS=45000
