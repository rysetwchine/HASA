# HASA API — environment template
# Copy to server/.env (never commit it) or set these in your host's dashboard.

NODE_ENV=development
PORT=3000

# --- Database ---------------------------------------------------------------
# Production (Render Free, walang disk): Turso Cloud.
#   Turso dashboard → Database → Connect → "libsql://...", plus a token.
# Kapag may TURSO_DATABASE_URL, awtomatikong Turso ang driver.
# HUWAG ilagay ang token sa client o sa Git.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Lokal na SQLite para sa dev at tests (ginagamit lamang kapag walang
# TURSO_DATABASE_URL). Sa host na may persistent volume, maaari mong itakda
# ang DATABASE_DRIVER=local upang pilitin ito kahit nasa production.
DATABASE_PATH=./server/data/hasa.sqlite
# DATABASE_DRIVER=local

# --- Security ---------------------------------------------------------------
# 32+ random characters. Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_DAYS=14

# Browser origin allowed to send credentialed requests (exact, no trailing /).
# Development default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Required to self-register teacher accounts (6–80 characters). Blank disables it.
TEACHER_SIGNUP_CODE=

# Set to 1 behind a reverse proxy such as Render/Railway/Fly.
TRUST_PROXY=0

# --- Optional AI simplification (server-side only) --------------------------
# Leave keys blank to disable. The app reports AI_NOT_CONFIGURED rather than
# inventing an answer.
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_QUOTA_PER_STUDENT=20
AI_REQUEST_TIMEOUT_MS=45000
