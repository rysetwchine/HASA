# HASA API — environment template
# Copy to server/.env (never commit it) or set these in your host's dashboard.
#   cp server/.env.example server/.env
# Ang server/.env ay nasa .gitignore — hindi ito kailanman naipupush.

NODE_ENV=development
PORT=3000

# --- Database: Turso Cloud ---------------------------------------------------
# Ang Turso ang nag-iimbak ng LAHAT ng datos: teacher/student accounts, sessions,
# lessons, quizzes, attempts, lesson_progress, points (XP), at badges.
#
# Saan makukuha (Turso dashboard → Database → Connect):
#   TURSO_DATABASE_URL : libsql://<database>-<org>.turso.io
#   TURSO_AUTH_TOKEN   : "Create token" (o: turso db tokens create hasa)
#
# PRIBADO ang token: server-side lang. Hindi ito dumadaan sa Vite, kaya hindi ito
# makikita sa browser bundle. Huwag itong ilagay sa client/ o sa Git.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Kapag may TURSO_DATABASE_URL, awtomatikong Turso ang driver — wala nang iba pang
# setting. Kapag blangko ito, lokal na SQLite ang gagamitin (dev, tests, at host na
# may persistent volume).
#
# DATABASE_PATH=./data/hasa.sqlite
# DATABASE_DRIVER=local   # pilitin ang lokal kahit naka-production

# --- Security ---------------------------------------------------------------
# 32+ random characters. Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_DAYS=14

# Browser origin allowed to send credentialed requests (exact, no trailing /).
# Development default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Required to self-register teacher accounts (6–80 characters). Blank disables it.
TEACHER_SIGNUP_CODE=

# Set to 1 behind a reverse proxy such as Render/Railway/Fly.
TRUST_PROXY=0

# --- Optional AI simplification (server-side only) --------------------------
# Leave keys blank to disable. The app reports AI_NOT_CONFIGURED rather than
# inventing an answer.
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_QUOTA_PER_STUDENT=20
AI_REQUEST_TIMEOUT_MS=45000

# --- Verifying the connection ----------------------------------------------
#   cd server
#   npm run db:check     # read-only: tables, row counts, relationships
#   npm run db:init      # idempotent: create missing tables + seed platform content
#   npm run test:turso   # 32 tests through @libsql/client on a throwaway file
