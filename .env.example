# HASA environment template
#
# Copy this file to `server/.env` and fill in real values.
# NEVER commit `server/.env`. NEVER expose any of these to the browser.
# Anything prefixed with VITE_ ends up in the frontend bundle — do not put
# secrets there, ever.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Session security ------------------------------------------------------
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Database --------------------------------------------------------------
DATABASE_PATH=./server/data/hasa.sqlite

# --- AI providers (server-side only) ---------------------------------------
# Leave a key blank to disable that provider. The app must show a clear
# "hindi naka-configure" message rather than inventing a response.
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: pin model names. Verify current names in each provider's docs
# before relying on them; model IDs change over time.
GEMINI_MODEL=
OPENAI_MODEL=

# --- Cost and abuse limits -------------------------------------------------
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_QUOTA_PER_STUDENT=30
AI_REQUEST_TIMEOUT_MS=45000

# --- Upload limits ---------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
